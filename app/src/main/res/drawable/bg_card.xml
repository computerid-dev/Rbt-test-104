<?xml version="1.0" encoding="utf-8"?>
<!-- Panel/kartu/tombol sekunder neo-brutalism dengan gaya sama seperti bg_button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp" android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="3dp" android:color="@color/border" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
